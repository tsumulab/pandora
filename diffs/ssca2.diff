+            }
+        } /* for j */
+
+        if (i == GPtr->numVertices-1) {
+            ULONGINT_T r = 0;
+            if (numEdgesPlaced-i0 >= 0) {
+                long ii = GPtr->outVertexIndex[i];
+                GPtr->paralEdgeIndex[ii+r] = i0;
+                GPtr->outVertexList[ii+r] = SDGdataPtr->endVertex[i0];
+                r++;
+                ULONGINT_T t;
+                for (t = i0+1; t < numEdgesPlaced; t++) {
