+
+    ULONGINT_T outVertexListSize = 0;
+
+    thread_barrier_wait();
+
+    ULONGINT_T i0 = -1UL;
+
+    for (i = i_start; i < i_stop; i++) {
+
+        ULONGINT_T k = i;
