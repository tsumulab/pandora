+                        i0 = j;
+                        break;
+                    }
+
+                }
+                k--;
+            }
+        }
+
+        if ((outVertexListSize == 0) && (k == 0)) {
+            i0 = 0;
+        }
+
+        for (j = i0; j < numEdgesPlaced; j++) {
+            if (i == GPtr->numVertices-1) {
+                break;
+            }
+            if ((i != SDGdataPtr->startVertex[j])) {
