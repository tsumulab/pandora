+/* =============================================================================
+ * allocBuckets
+ * -- Returns NULL on error
+ * =============================================================================
+ */
+static rbtree_t**
+allocBuckets (long numBucket, long (*comparePairs)(const pair_t*, const pair_t*))
+{
+    long i;
+    rbtree_t** buckets;
+
+    /* Allocate bucket: extra bucket is dummy for easier iterator code */
+    buckets = (rbtree_t**)P_MALLOC((numBucket + 1) * sizeof(rbtree_t*));
+    if (buckets == NULL) {
+        return NULL;
+    }
+
+    for (i = 0; i < (numBucket + 1); i++) {
+        rbtree_t* chainPtr = rbtree_alloc(NULL);
+        if (chainPtr == NULL) {
+            while (--i >= 0) {
+                rbtree_free(buckets[i]);
+            }
+            return NULL;
+        }
+        buckets[i] = chainPtr;
+    }
+
+    return buckets;
+}
+
+
+/* =============================================================================
+ * TMallocBuckets
+ * -- Returns NULL on error
+ * =============================================================================
+ */
+static rbtree_t**
+TMallocBuckets (TM_ARGDECL
+                long numBucket, long (*comparePairs)(const pair_t*, const pair_t*))
+{
+    long i;
+    rbtree_t** buckets;
+
+    /* Allocate bucket: extra bucket is dummy for easier iterator code */
+    buckets = (rbtree_t**)TM_MALLOC((numBucket + 1) * sizeof(rbtree_t*));
+    if (buckets == NULL) {
+        return NULL;
+    }
+
+    for (i = 0; i < (numBucket + 1); i++) {
+        rbtree_t* chainPtr = TMrbtree_alloc(TM_ARG NULL);
+        if (chainPtr == NULL) {
+            while (--i >= 0) {
+                TMRBTREE_FREE(buckets[i]);
+            }
+            return NULL;
+        }
+        buckets[i] = chainPtr;
+    }
+
+    return buckets;
+}
+
+
+/* =============================================================================
+ * hashtable_alloc
+ * -- Returns NULL on failure
+ * -- Negative values for resizeRatio or growthFactor select default values
+ * =============================================================================
+ */
+hashtable_t*
+hashtable_alloc (long initNumBucket,
+                 ulong_t (*hash)(const void*),
+                 long (*comparePairs)(const pair_t*, const pair_t*),
+                 long resizeRatio,
+                 long growthFactor)
+{
+    hashtable_t* hashtablePtr;
+
+    hashtablePtr = (hashtable_t*)P_MALLOC(sizeof(hashtable_t));
+    if (hashtablePtr == NULL) {
+        return NULL;
+    }
+
+    hashtablePtr->hash = (hash ? hash : &defaultHash);
+    hashtablePtr->comparePairs = (comparePairs ? comparePairs : &defaultComparePairs);
+
+    {
+        char* s;
+        s = getenv("HASH_NBUCKET");
+        if (s != NULL) {
+            initNumBucket = strtol(s, NULL, 10);
+        }
+    }
+
+    hashtablePtr->buckets = allocBuckets(initNumBucket, hashtablePtr->comparePairs);
+    if (hashtablePtr->buckets == NULL) {
+        P_FREE(hashtablePtr);
+        return NULL;
+    }
+
+    hashtablePtr->numBucket = initNumBucket;
+    hashtablePtr->size = (long*)P_MALLOC(initNumBucket * sizeof(long));
+
+    return hashtablePtr;
+}
+
+
+/* =============================================================================
+ * TMhashtable_alloc
+ * -- Returns NULL on failure
+ * -- Negative values for resizeRatio or growthFactor select default values
+ * =============================================================================
+ */
+hashtable_t*
+TMhashtable_alloc (TM_ARGDECL
+                   long initNumBucket,
+                   ulong_t (*hash)(const void*),
+                   long (*comparePairs)(const pair_t*, const pair_t*),
+                   long resizeRatio,
+                   long growthFactor)
+{
+    hashtable_t* hashtablePtr;
+
+    hashtablePtr = (hashtable_t*)TM_MALLOC(sizeof(hashtable_t));
+    if (hashtablePtr == NULL) {
+        return NULL;
+    }
+
+    hashtablePtr->hash = (hash ? hash : &defaultHash);
+    hashtablePtr->comparePairs = (comparePairs ? comparePairs : &defaultComparePairs);
+
+    hashtablePtr->buckets = TMallocBuckets(TM_ARG  initNumBucket, comparePairs);
+    if (hashtablePtr->buckets == NULL) {
+        TM_FREE(hashtablePtr);
+        return NULL;
+    }
+
+    hashtablePtr->numBucket = initNumBucket;
+    hashtablePtr->size = (long*)TM_MALLOC(initNumBucket * sizeof(long));
+
+    return hashtablePtr;
+}
+
+
+/* =============================================================================
+ * freeBuckets
+ * =============================================================================
+ */
+static void
+freeBuckets (rbtree_t** buckets, long numBucket)
+{
+    long i;
+
+    for (i = 0; i < numBucket; i++) {
+        rbtree_free(buckets[i]);
+    }
+
+    P_FREE(buckets);
+}
+
+
+/* =============================================================================
+ * TMfreeBuckets
+ * =============================================================================
+ */
+static void
+TMfreeBuckets (TM_ARGDECL  rbtree_t** buckets, long numBucket)
+{
