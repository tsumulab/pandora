+{
+    list_node_t* nodePtr;
+    list_node_t* prevPtr = findPrevious(listPtr, dataPtr);
+
+    nodePtr = prevPtr->nextPtr;
+
+    if ((nodePtr == NULL) ||
+        (listPtr->compare(nodePtr->dataPtr, dataPtr) != 0)) {
+        return NULL;
+    }
+
+    return (nodePtr->dataPtr);
