+
+/* =============================================================================
+ * hashtable_isEmpty
+ * =============================================================================
+ */
+bool_t
+hashtable_isEmpty (hashtable_t* hashtablePtr)
+{
+    return (hashtable_getSize(hashtablePtr) == 0 ? TRUE : FALSE);
+}
+
+
+/* =============================================================================
+ * TMhashtable_isEmpty
+ * =============================================================================
+ */
+bool_t
+TMhashtable_isEmpty (TM_ARGDECL  hashtable_t* hashtablePtr)
+{
+    return (TMHASHTABLE_GETSIZE(hashtablePtr) == 0 ? TRUE : FALSE);
+}
+
+
+/* =============================================================================
+ * hashtable_getSize
+ * -- Returns number of elements in hash table
+ * =============================================================================
+ */
+long
+hashtable_getSize (hashtable_t* hashtablePtr)
+{
+    long i;
+    long size = 0;
+
+    for (i = 0; i < hashtablePtr->numBucket; i++) {
+        size += hashtablePtr->size[i];
+    }
+    return size;
+}
+
+
+/* =============================================================================
+ * TMhashtable_getSize
+ * -- Returns number of elements in hash table
+ * =============================================================================
+ */
+long
+TMhashtable_getSize (TM_ARGDECL  hashtable_t* hashtablePtr)
+{
+    long i;
+    long size = 0;
+
+    for (i = 0; i < hashtablePtr->numBucket; i++) {
+        size += (long)TM_SHARED_READ(hashtablePtr->size[i]);
+    }
+    return size;
+}
+
+
+/* =============================================================================
+ * hashtable_containsKey
+ * =============================================================================
+ */
+bool_t
+hashtable_containsKey (hashtable_t* hashtablePtr, void* keyPtr)
+{
+    long i = hashtablePtr->hash(keyPtr) % hashtablePtr->numBucket;
+
+    return rbtree_contains(hashtablePtr->buckets[i], keyPtr);
+}
+
+
+/* =============================================================================
+ * TMhashtable_containsKey
+ * =============================================================================
+ */
+bool_t
+TMhashtable_containsKey (TM_ARGDECL  hashtable_t* hashtablePtr, void* keyPtr)
+{
+    long i = hashtablePtr->hash(keyPtr) % hashtablePtr->numBucket;
+
+    return TMRBTREE_CONTAINS(hashtablePtr->buckets[i], keyPtr);
+}
+
+
+/* =============================================================================
+ * hashtable_find
+ * -- Returns NULL on failure, else pointer to data associated with key
+ * =============================================================================
+ */
+void*
+hashtable_find (hashtable_t* hashtablePtr, void* keyPtr)
+{
+    long i = hashtablePtr->hash(keyPtr) % hashtablePtr->numBucket;
+
+    return rbtree_get(hashtablePtr->buckets[i], keyPtr);
+}
+
+
+/* =============================================================================
+ * TMhashtable_find
+ * -- Returns NULL on failure, else pointer to data associated with key
+ * =============================================================================
+ */
+void*
+TMhashtable_find (TM_ARGDECL  hashtable_t* hashtablePtr, void* keyPtr)
+{
+    long i = hashtablePtr->hash(keyPtr) % hashtablePtr->numBucket;
+
+    return TMRBTREE_GET(hashtablePtr->buckets[i], keyPtr);
+}
+
+
+/* =============================================================================
+ * hashtable_insert
+ * =============================================================================
+ */
+bool_t
+hashtable_insert (hashtable_t* hashtablePtr, void* keyPtr, void* dataPtr)
+{
+    long numBucket = hashtablePtr->numBucket;
+    long i = hashtablePtr->hash(keyPtr) % numBucket;
+
+    if (rbtree_insert(hashtablePtr->buckets[i], keyPtr, dataPtr) == FALSE) {
+        return FALSE;
+    }
+
+    long newSize = hashtablePtr->size[i] + 1;
+    assert(newSize > 0);
+    hashtablePtr->size[i] = newSize;
+
+    return TRUE;
+}
+
+
+/* =============================================================================
+ * TMhashtable_insert
+ * =============================================================================
+ */
+bool_t
+TMhashtable_insert (TM_ARGDECL
+                    hashtable_t* hashtablePtr, void* keyPtr, void* dataPtr)
+{
+    long numBucket = hashtablePtr->numBucket;
+    long i = hashtablePtr->hash(keyPtr) % numBucket;
+
+    if (TMRBTREE_INSERT(hashtablePtr->buckets[i], keyPtr, dataPtr) == FALSE) {
+        return FALSE;
+    }
+
+    long newSize = (long)TM_SHARED_READ(hashtablePtr->size[i]) + 1;
+    assert(newSize > 0);
+    TM_SHARED_WRITE(hashtablePtr->size[i], newSize);
+
+    return TRUE;
+}
+
+
+/* =============================================================================
+ * hashtable_remove
+ * -- Returns TRUE if successful, else FALSE
+ * =============================================================================
+ */
+bool_t
+hashtable_remove (hashtable_t* hashtablePtr, void* keyPtr)
+{
+    long numBucket = hashtablePtr->numBucket;
+    long i = hashtablePtr->hash(keyPtr) % numBucket;
+
+    if (rbtree_delete(hashtablePtr->buckets[i], keyPtr) == FALSE) {
+        return FALSE;
+    }
+
+    long newSize = hashtablePtr->size[i] - 1;
+    assert(newSize >= 0);
+    hashtablePtr->size[i] = newSize;
+
+    return TRUE;
+}
+
+
+/* =============================================================================
+ * TMhashtable_remove
+ * -- Returns TRUE if successful, else FALSE
+ * =============================================================================
+ */
+bool_t
+TMhashtable_remove (TM_ARGDECL  hashtable_t* hashtablePtr, void* keyPtr)
+{
+    long numBucket = hashtablePtr->numBucket;
+    long i = hashtablePtr->hash(keyPtr) % numBucket;
+
+    if (TMRBTREE_DELETE(hashtablePtr->buckets[i], keyPtr) == FALSE) {
+        return FALSE;
+    }
+
+    long newSize = (long)TM_SHARED_READ(hashtablePtr->size[i]) - 1;
+    assert(newSize >= 0);
+    TM_SHARED_WRITE(hashtablePtr->size[i], newSize);
+
+    return TRUE;
+}
+
