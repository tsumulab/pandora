+static list_node_t*
+findPrevious (list_t* listPtr, void* dataPtr)
+{
+    list_node_t* prevPtr = &(listPtr->head);
+    list_node_t* nodePtr = prevPtr->nextPtr;
+
+    for (; nodePtr != NULL; nodePtr = nodePtr->nextPtr) {
+        if (listPtr->compare(nodePtr->dataPtr, dataPtr) == 0) {
+            return prevPtr;
+        }
+        prevPtr = nodePtr;
+    }
+
+    return prevPtr;
+}
