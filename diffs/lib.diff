+void
+hashtable_free (hashtable_t* hashtablePtr)
+{
+    freeBuckets(hashtablePtr->buckets, hashtablePtr->numBucket);
+    P_FREE(hashtablePtr->size);
+    P_FREE(hashtablePtr);
+}
+
+
+/* =============================================================================
