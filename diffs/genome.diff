+        list_iter_t it;
+        ulong_t lock_idx;
+        long num = localHashtablePtr->numBucket;
+        for (i = 0; i < num; ++i) {
+            chainPtr = localHashtablePtr->buckets[i];
+            list_iter_reset(&it, chainPtr);
+
+            while (list_iter_hasNext(&it, chainPtr)) {
+                void* segment =
+                    (void*)((pair_t*)list_iter_next(&it, chainPtr))->firstPtr;
