diff -ruN -X /tmp/exc_rt2 master/tinystm-1.0.5/Makefile.common pandora-supplement/tinySTM-1.0.5/Makefile.common
--- master/tinystm-1.0.5/Makefile.common	2014-07-23 08:23:50.000000000 +0900
+++ pandora-supplement/tinySTM-1.0.5/Makefile.common	2026-07-28 12:31:46.349534200 +0900
@@ -34,9 +34,12 @@
 # Solaris default memory allocator is quite slow, better use mtmalloc
 # LDFLAGS += -lmtmalloc
 
-# Disable additionnal checks from glibc (__longjmp_chk/__printf_chk)
-# CPPFLAGS += -U_FORTIFY_SOURCE
-# CPPFLAGS += -D_FORTIFY_SOURCE=0
+# Disable additionnal checks from glibc (__longjmp_chk/__printf_chk).
+# Required under libfibre: transactions abort via siglongjmp across user-level-thread
+# stacks, which glibc's _FORTIFY_SOURCE longjmp check misreads as an "uninitialized
+# stack frame" and aborts (intermittently, depending on stack layout).
+CPPFLAGS += -U_FORTIFY_SOURCE
+CPPFLAGS += -D_FORTIFY_SOURCE=0
 # Enable multi-thread support in glibc
 CPPFLAGS += -D_REENTRANT
 
