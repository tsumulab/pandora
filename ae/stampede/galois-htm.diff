+++ gb/include/Galois/Runtime/htm.h	2025-01-14 12:41:07.000000000 +0900
@@ -0,0 +1,212 @@
+#ifndef _HTM_H
+#define _HTM_H
+
+#if defined(__x86_64__) || defined(__i386)
+	#define L1_CACHE_SIZE   (32L*1024L)
+	#define L1_BLOCK_SIZE           64L // 64 bytes per block/line
+	#define L1_BLOCKS_PER_SET        8L // 8-way set associative
+	#define L1_WORDS_PER_BLOCK       8L
+	#define L1_NUM_SETS          (L1_CACHE_SIZE/(L1_BLOCK_SIZE*L1_BLOCKS_PER_SET))
+	#define L1_SET_BLOCK_OFFSET  ((L1_NUM_SETS*L1_BLOCK_SIZE)/sizeof(long))
+	#define CACHE_ALIGNMENT		   (L1_NUM_SETS*L1_BLOCK_SIZE)
+#else /* PowerPC */
+	#define L1_CACHE_SIZE   (512L*1024L)
+	#define L1_BLOCK_SIZE          128L // 128 bytes per block/line
+	#define L1_BLOCKS_PER_SET        8L // 8-way set associative
+	#define L1_WORDS_PER_BLOCK      16L
+	#define L1_NUM_SETS          (L1_CACHE_SIZE/(L1_BLOCK_SIZE*L1_BLOCKS_PER_SET))
+	#define L1_SET_BLOCK_OFFSET  ((L1_NUM_SETS*L1_BLOCK_SIZE)/sizeof(long))
+	#define CACHE_ALIGNMENT			 (L1_NUM_SETS*L1_BLOCK_SIZE)
+#endif /* PowerPC */
+
+#ifndef __ALIGN__
+#define __ALIGN__ __attribute__((aligned(CACHE_ALIGNMENT)))
+#endif
+
+#if defined(__powerpc__) || defined(__ppc__) || defined(__PPC__)
+
+#include <htmintrin.h>
+#include <pthread.h>
+#include "power9/htm_power9.h"
+
+/*
+ * ロック
+ */
+#define lock_t volatile long
+#define LOCK_INITIALIZER 0
+
+#define IS_LOCKED(l) (__atomic_load_n(l,__ATOMIC_SEQ_CST) == 1)
+#define LOCK(l) while (__atomic_exchange_n(l,1, __ATOMIC_SEQ_CST)) pthread_yield()
+#define UNLOCK(l) __atomic_store_n(l, 0, __ATOMIC_SEQ_CST)
+
+namespace Galois{
+namespace Runtime{
+
+static lock_t __htm_global_lock __ALIGN__ = LOCK_INITIALIZER;
+
+enum AbortReason {
+    NOT_ABORTED = 0,
+    LOCK_CONFLICT = 1,
+    PERSISTENT = 2,
+    TRANSIENT = 3
+};
+
+}
+}
+
+
+/*
+ * HTM operations
+ */
+
+#define ABORT_PERSISTENT		      (1 << (31-7))
+#define ABORT_ILLEGAL		          (1 << (31-8))
+#define ABORT_NESTED		          (1 << (31-9))
+#define ABORT_CAPACITY	          (1 << (31-10))
+#define ABORT_SUSPENDED_CONFLICT	(1 << (31-11))
+#define ABORT_NON_TX_CONFLICT	    (1 << (31-12))
+#define ABORT_TX_CONFLICT	        (1 << (31-13))
+#define ABORT_TLB_CONFLICT	      (1 << (31-14))
+#define ABORT_IMPL_SPECIFIC	      (1 << (31-15))
+#define ABORT_FETCH_CONFLICT	    (1 << (31-16))
+#define ABORT_EXPLICIT	          (1 << (31-31))
+// #define HTM_ABORT_PERSISTENT(s)   ((s & ABORT_PERSISTENT) && !(s & ABORT_EXPLICIT))
+#define HTM_ABORT_PERSISTENT(s)   (IS_ABORT_PERSISTENT(s))
+#define HTM_ABORT_REASON(s) ((texasr_t)__builtin_get_texasr())
+
+#define HTM_BEGIN(tld, ar, transient_ctr, persistent_ctr) do{ \
+                                uint32_t __tx_status = __builtin_tbegin(0); \
+                                if (__tx_status != 0) { \
+                                    if (IS_LOCKED(&__htm_global_lock)) { \
+                                        __builtin_tabort(0xab); \
+                                    } \
+                                    break; \
+                                } else { \
+                                    if (IS_LOCKED(&__htm_global_lock)) { \
+                                        ar = LOCK_CONFLICT; \
+                                        while( IS_LOCKED(&__htm_global_lock) ) pthread_yield(); \
+                                    } else { \
+                                        texasr_t abort_reason __ALIGN__ = HTM_ABORT_REASON(__tx_status); \
+                                        tld.stat.inc_abortreason(abort_reason); \
+                                        if (HTM_ABORT_PERSISTENT(abort_reason)) { \
+                                            ar = PERSISTENT; \
+                                        } else { \
+                                            ar = TRANSIENT; \
+                                        } \
+                                        if (ar==TRANSIENT && transient_ctr >= (serializationTreeHeight * 7)) { \
+                                            tld.stat.inc_whichCausedLock(false); \
+                                            LOCK(&__htm_global_lock); \
+                                            break; \
+                                        } \
+                                        if (ar==PERSISTENT && persistent_ctr >= 0) { \
+                                            tld.stat.inc_whichCausedLock(true); \
+                                            LOCK(&__htm_global_lock); \
+                                            break; \
+                                        } \
+                                    } \
+                                    forceAbort(); \
+                                } \
+                            } while(0)
+
+#define HTM_END(tld)   do { \
+                        if (IS_LOCKED(&__htm_global_lock)) { \
+                            UNLOCK(&__htm_global_lock); \
+                            tld.stat.inc_committype(true); \
+                        } else { \
+                            __builtin_tend(0); \
+                            tld.stat.inc_committype(false); \
+                        } \
+                    } while(0)
+
+#elif defined(__x86_64__) || defined(__i386)
+
+/*
+ * ロック
+*/
+#include <immintrin.h>
+#include <pthread.h>
+#include "intel/htm_intel.h"
+
+#define lock_t volatile long
+#define LOCK_INITIALIZER 0
+
+#define IS_LOCKED(l) (__atomic_load_n(l, __ATOMIC_SEQ_CST) == 1)
+#define LOCK(l) while (__atomic_exchange_n(l,1, __ATOMIC_SEQ_CST)) pthread_yield()
+
+#define UNLOCK(l) __atomic_store_n(l, 0, __ATOMIC_RELEASE)
+
+namespace Galois{
+namespace Runtime{
+
+static lock_t __htm_global_lock __ALIGN__ = LOCK_INITIALIZER;
+
+enum AbortReason {
+    NOT_ABORTED = 0,
+    LOCK_CONFLICT = 1,
+    PERSISTENT = 2,
+    TRANSIENT = 3
+};
+
+}
+}
+
+
+/*
+ * HTM operations
+*/
+
+#define HTM_ABORT_PERSISTENT(s) (!(s & _XABORT_RETRY))
+#define HTM_ABORT_REASON(s) (s & 0x3E)
+
+#define HTM_BEGIN(tld, ar, transient_ctr, persistent_ctr) do{ \
+                                uint32_t __tx_status = _xbegin(); \
+                                if (__tx_status == _XBEGIN_STARTED) { \
+                                    if (IS_LOCKED(&__htm_global_lock)) { \
+                                        _xabort(0xab); \
+                                    } \
+                                    break; \
+                                } else { \
+                                    if (IS_LOCKED(&__htm_global_lock)) { \
+                                        ar = LOCK_CONFLICT; \
+                                        while( IS_LOCKED(&__htm_global_lock) ) pthread_yield(); \
+                                    } else { \
+                                        uint32_t abort_reason __ALIGN__ = HTM_ABORT_REASON(__tx_status); \
+                                        tld.stat.inc_abortreason(abort_reason); \
+                                        if (HTM_ABORT_PERSISTENT(__tx_status)) { \
+                                            ar = PERSISTENT; \
+                                        } else { \
+                                            ar = TRANSIENT; \
+                                        } \
+                                        if (ar==TRANSIENT && transient_ctr >= (serializationTreeHeight * 7)) { \
+                                            tld.stat.inc_whichCausedLock(false); \
+                                            LOCK(&__htm_global_lock); \
+                                            break; \
+                                        } \
+                                        if (ar==PERSISTENT && persistent_ctr >= 0) { \
+                                            tld.stat.inc_whichCausedLock(true); \
+                                            LOCK(&__htm_global_lock); \
+                                            break; \
+                                        } \
+                                    } \
+                                    forceAbort(); \
+                                } \
+                            } while(0)
+
+#define HTM_END(tld)   do { \
+                        if (IS_LOCKED(&__htm_global_lock)) { \
+                            UNLOCK(&__htm_global_lock); \
+                            tld.stat.inc_committype(true); \
+                        } else { \
+                            _xend(); \
+                            tld.stat.inc_committype(false); \
+                        } \
+                    } while(0)
+
+#elif defined(__bgq__)
+
+// TODO とりあえず出すときには書いておくこと
+
+#endif // EACH_ARCHITECTURE
+
+#endif // _HTM_H
+
