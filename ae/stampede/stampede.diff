+                               8/*968*/,8/*976*/,8/*984*/,8/*992*/,8/*1000*/,8/*1008*/,8/*1016*/,8/*1024*/,
+                          };
+static int sizetoclass_pop[129] = {0,1/*8*/,2/*16*/,3/*24*/,4/*32*/,4/*40*/,5/*48*/,5/*56*/,5/*64*/,
+                               5/*72*/,6/*80*/,6/*88*/,6/*96*/,6/*104*/,6/*112*/,6/*120*/,6/*128*/,
