+extern global_t _tinystm;
+
+#if CM == CM_MODULAR
+# define KILL_SELF                      0x00
+# define KILL_OTHER                     0x01
+# define DELAY_RESTART                  0x04
+
+# define RR_CONFLICT                    0x00
+# define RW_CONFLICT                    0x01
+# define WR_CONFLICT                    0x02
+# define WW_CONFLICT                    0x03
+#endif /* CM == CM_MODULAR */
