@@ -0,0 +1,229 @@
+#ifndef _HTM_H
+#define _HTM_H
+
+#if defined(__x86_64__) || defined(__i386)
+	#define L1_CACHE_SIZE   (32L*1024L)
+	#define L1_BLOCK_SIZE           64L // 64 bytes per block/line
+	#define L1_BLOCKS_PER_SET        8L // 8-way set associative
+	#define L1_WORDS_PER_BLOCK       8L
+	#define L1_NUM_SETS          (L1_CACHE_SIZE/(L1_BLOCK_SIZE*L1_BLOCKS_PER_SET))
+	#define L1_SET_BLOCK_OFFSET  ((L1_NUM_SETS*L1_BLOCK_SIZE)/sizeof(long))
+	#define CACHE_ALIGNMENT		   (L1_NUM_SETS*L1_BLOCK_SIZE)
+#else /* PowerPC */
+	#define L1_CACHE_SIZE   (512L*1024L)
+	#define L1_BLOCK_SIZE          128L // 128 bytes per block/line
+	#define L1_BLOCKS_PER_SET        8L // 8-way set associative
+	#define L1_WORDS_PER_BLOCK      16L
+	#define L1_NUM_SETS          (L1_CACHE_SIZE/(L1_BLOCK_SIZE*L1_BLOCKS_PER_SET))
+	#define L1_SET_BLOCK_OFFSET  ((L1_NUM_SETS*L1_BLOCK_SIZE)/sizeof(long))
+	#define CACHE_ALIGNMENT			 (L1_NUM_SETS*L1_BLOCK_SIZE)
+#endif /* PowerPC */
+
+#ifndef __ALIGN__
+#define __ALIGN__ __attribute__((aligned(CACHE_ALIGNMENT)))
+#endif
+
+#include <pthread.h>
+
+#define lock_t volatile long
+#define LOCK_INITIALIZER 0
+static lock_t __htm_global_lock __ALIGN__ = LOCK_INITIALIZER;
+
+extern __thread unsigned int transient_counter;
+extern __thread unsigned int persistent_counter;
+
+extern __thread unsigned long RetryCtr;
+
+extern __thread unsigned long HTMEnd_LOCK_Per;
+extern __thread unsigned long HTMEnd_LOCK_Tra;
+
+extern __thread unsigned long HTMEnd_Tx;
+extern __thread unsigned long HTMEnd_LOCK;
+
+extern __thread unsigned long HTMTxConflict;
+extern __thread unsigned long HTMCapacity;
+extern __thread unsigned long HTMIllegal;
+extern __thread unsigned long HTMNested;
+extern __thread unsigned long HTM0;
+extern __thread unsigned long other;
+
+#ifdef USE_POWER
+extern __thread unsigned long HTMNonTxConflict;
+extern __thread unsigned long HTMTLBConflict;
+extern __thread unsigned long HTMImplSpecific;
+extern __thread unsigned long HTMFetchConflict;
+extern __thread unsigned long HTMPersistent;
+#endif
+
+/* reduction用変数 */
+extern unsigned long reduction_RetryCtr;
+
+extern unsigned long reduction_HTMEnd_LOCK_Per;
+extern unsigned long reduction_HTMEnd_LOCK_Tra;
