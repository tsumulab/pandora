+
+/*
+ * ロック
+ */
+#define lock_t volatile long
+#define LOCK_INITIALIZER 0
+
+#define IS_LOCKED(l) (__atomic_load_n(l,__ATOMIC_SEQ_CST) == 1)
+#define LOCK(l) while (__atomic_exchange_n(l,1, __ATOMIC_SEQ_CST)) pthread_yield()
+#define UNLOCK(l) __atomic_store_n(l, 0, __ATOMIC_SEQ_CST)
+
+
+/*
+ * HTM operations
+ */
+
+#define ABORT_PERSISTENT		      (1 << (31-7))
+#define ABORT_ILLEGAL		          (1 << (31-8))
+#define ABORT_NESTED		          (1 << (31-9))
+#define ABORT_CAPACITY	          (1 << (31-10))
+#define ABORT_SUSPENDED_CONFLICT	(1 << (31-11))
+#define ABORT_NON_TX_CONFLICT	    (1 << (31-12))
+#define ABORT_TX_CONFLICT	        (1 << (31-13))
+#define ABORT_TLB_CONFLICT	      (1 << (31-14))
+#define ABORT_IMPL_SPECIFIC	      (1 << (31-15))
+#define ABORT_FETCH_CONFLICT	    (1 << (31-16))
+#define ABORT_EXPLICIT	          (1 << (31-31))
+// #define HTM_ABORT_PERSISTENT(s)   ((s & ABORT_PERSISTENT) && !(s & ABORT_EXPLICIT))
+#define HTM_ABORT_PERSISTENT(s)   (IS_ABORT_PERSISTENT(s))
+#define HTM_ABORT_REASON(s) ((texasr_t)__builtin_get_texasr())
+
+#define HTM_BEGIN() persistent_counter = 0; transient_counter = 0; do{ \
+                                u_int32_t __tx_status = __builtin_tbegin(0); \
+                                if (__tx_status != 0) { \
+                                    if (IS_LOCKED(&__htm_global_lock)) { \
+                                        __builtin_tabort(0xab); \
+                                    } \
+                                    break; \
+                                } else { \
+                                    if (IS_LOCKED(&__htm_global_lock)) { \
+                                        while( IS_LOCKED(&__htm_global_lock) ) pthread_yield(); \
+                                    } else { \
+                                        texasr_t abort_reason __ALIGN__ = HTM_ABORT_REASON(__tx_status); \
+                                        inc_abortreason(abort_reason); \
+                                        if (HTM_ABORT_PERSISTENT(abort_reason)) { \
+                                            persistent_counter += 1; \
+                                        } else { \
+                                            transient_counter += 1; \
+                                        } \
+                                        if (transient_counter >= 30) { \
+                                            HTMEnd_LOCK_Tra += 1; \
+                                            LOCK(&__htm_global_lock); \
+                                            break; \
+                                        } \
+                                        if (persistent_counter >= 1) { \
+                                            HTMEnd_LOCK_Per += 1; \
+                                            LOCK(&__htm_global_lock); \
+                                            break; \
+                                        } \
+                                    } \
+                                    RetryCtr += 1; \
+                                } \
+                            } while(1)
+
+#define HTM_END()   do { \
+                        if (IS_LOCKED(&__htm_global_lock)) { \
+                            UNLOCK(&__htm_global_lock); \
+                            HTMEnd_LOCK += 1; \
+                        } else { \
+                            __builtin_tend(0); \
+                            HTMEnd_Tx += 1; \
+                        } \
+                    } while(0)
+
+#elif defined(__x86_64__) || defined(__i386)
+
+/*
+ * ロック
+*/
+#include <immintrin.h>
+#include "intel/htm_intel.h"
+
+#define IS_LOCKED(l) (__atomic_load_n(l, __ATOMIC_SEQ_CST) == 1)
+#define LOCK(l) while (__atomic_exchange_n(l,1, __ATOMIC_SEQ_CST)) pthread_yield()
+
+#define UNLOCK(l) __atomic_store_n(l, 0, __ATOMIC_RELEASE)
+
+/*
+ * HTM operations
+*/
+
+#define HTM_ABORT_PERSISTENT(s) (!(s & _XABORT_RETRY))
+#define HTM_ABORT_REASON(s) (s & 0x3E)
+
+#define HTM_BEGIN() persistent_counter = 0; transient_counter = 0; do{ \
+                                u_int32_t __tx_status = _xbegin(); \
+                                if (__tx_status == _XBEGIN_STARTED) { \
+                                    if (IS_LOCKED(&__htm_global_lock)) { \
+                                        _xabort(0xab); \
+                                    } \
+                                    break; \
+                                } else { \
+                                    if (IS_LOCKED(&__htm_global_lock)) { \
+                                        while( IS_LOCKED(&__htm_global_lock) ) pthread_yield(); \
+                                    } else { \
+                                        u_int32_t abort_reason __ALIGN__ = HTM_ABORT_REASON(__tx_status); \
+                                        inc_abortreason(abort_reason); \
+                                        if (HTM_ABORT_PERSISTENT(abort_reason)) { \
+                                            persistent_counter += 1; \
+                                        } else { \
+                                            transient_counter += 1; \
+                                        } \
+                                        if (transient_counter >= 30) { \
+                                            HTMEnd_LOCK_Tra += 1; \
+                                            LOCK(&__htm_global_lock); \
+                                            break; \
+                                        } \
+                                        if (persistent_counter >= 1) { \
+                                            HTMEnd_LOCK_Per += 1; \
+                                            LOCK(&__htm_global_lock); \
+                                            break; \
+                                        } \
+                                    } \
+                                    RetryCtr += 1; \
+                                } \
+                            } while(1)
+
+#define HTM_END()   do { \
+                        if (IS_LOCKED(&__htm_global_lock)) { \
+                            UNLOCK(&__htm_global_lock); \
+                            HTMEnd_LOCK += 1; \
+                        } else { \
+                            _xend(); \
+                            HTMEnd_Tx += 1; \
+                        } \
+                    } while(0)
+
+#elif defined(__bgq__)
+
+// TODO とりあえず出すときには書いておくこと
+
+#endif // EACH_ARCHITECTURE
+
+#endif // _HTM_H
