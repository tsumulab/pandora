--- a/benchmarks/htm/htm.c	1970-01-01 09:00:00.000000000 +0900
+++ b/benchmarks/htm/htm.c	2025-04-22 09:59:39.000000000 +0900
@@ -0,0 +1,75 @@
+#include <stdio.h>
+#include "htm.h"
+
+
+__thread unsigned int transient_counter = 0;
+__thread unsigned int persistent_counter = 0;
+
+__thread unsigned long RetryCtr = 0;
+
+__thread unsigned long HTMEnd_LOCK_Per = 0;
+__thread unsigned long HTMEnd_LOCK_Tra = 0;
+
+__thread unsigned long HTMEnd_Tx = 0;
+__thread unsigned long HTMEnd_LOCK = 0;
+
+__thread unsigned long HTMTxConflict=0;
+__thread unsigned long HTMCapacity=0;
+__thread unsigned long HTMIllegal=0;
+__thread unsigned long HTMNested=0;
+__thread unsigned long HTM0=0;
+__thread unsigned long other=0;
+
+#ifdef USE_POWER
+__thread unsigned long HTMNonTxConflict=0;
+__thread unsigned long HTMTLBConflict=0;
+__thread unsigned long HTMImplSpecific=0;
+__thread unsigned long HTMFetchConflict=0;
+__thread unsigned long HTMPersistent=0;
+#endif
+
+#ifdef USE_POWER
+void inc_abortreason(texasr_t abortcode) {
+    if (IS_ABORT_TX_CONFLICT(abortcode)) {
+        HTMTxConflict+=1;
+    } else if (IS_ABORT_NON_TX_CONFLICT(abortcode)) {
+        HTMNonTxConflict+=1;
+    } else if (IS_ABORT_CAPACITY(abortcode)) {
+        HTMCapacity+=1;
+    } else if (IS_ABORT_ILLEGAL(abortcode)) {
+        HTMIllegal+=1;
+    } else if (IS_ABORT_NESTED(abortcode)) {
+        HTMNested+=1;
+    } else if (IS_ABORT_TLB_CONFLICT(abortcode)) {
+        HTMTLBConflict+=1;
+    } else if (IS_ABORT_FETCH_CONFLICT(abortcode)) {
+        HTMFetchConflict+=1;
+    } else if (IS_ABORT_PERSISTENT(abortcode)) {
+        HTMPersistent+=1;
+    } else if (IS_ABORT_IMPL_SPECIFIC(abortcode)) {
+        HTMImplSpecific+=1;
+    } else if (abortcode == 0) {
+        HTM0+=1;
+    } else {
+        other+=1;
+    }
+}
+
+#elif defined(USE_INTEL)
+void inc_abortreason(u_int32_t abortcode) {
+    if (abortcode & _XABORT_CONFLICT) {
+      HTMTxConflict+=1;
+    } else if (abortcode & _XABORT_CAPACITY) {
+        HTMCapacity+=1;
+    } else if (abortcode & _XABORT_DEBUG) {
+        HTMIllegal+=1;
+    } else if (abortcode & _XABORT_NESTED) {
+        HTMNested+=1;
+    } else if (abortcode == 0) {
+        HTM0+=1;
+    } else {
+        other+=1;
+    }
+}
+
+#endif
