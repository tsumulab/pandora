# ==============================================================================
#
# Makefile.common
#
# ==============================================================================


CFLAGS += -DUSE_NORMAL_BARRIER_FUNC

%.o: %.c *.h
	$(CC) $(CFLAGS) -c $< -o $@

%.o: %.cpp *.h
	$(CPP) $(CPPFLAGS) -c $< -o $@

.PHONY: default
default: $(PROG)

.PHONY: clean
clean:
	$(RM) *.o $(PROG)

$(PROG): $(OBJS)
	$(LD) $(LDFLAGS) $^ $(LIBS) -o $(PROG)


# ==============================================================================
#
# End of Makefile.common
#
# ==============================================================================
